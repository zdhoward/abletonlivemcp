# Public source and reproducible checks only. Personal work stays local.
/*
!/.gitignore
!/pyproject.toml
!/README.md
!/LICENSE
!/NOTICE
!/CHANGELOG.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/src/
!/remote_script/
/remote_script/*
!/remote_script/AbletonLiveMCP/
!/tests/
!/.github/

# Public documentation and artwork.
!/assets/
/assets/*
!/assets/icon.svg
!/docs/
/docs/*
!/docs/validation.md
!/docs/permissions.md
!/docs/data/
/docs/data/*
!/docs/data/live-12.2-api.json

# Only the reusable proof/test dependencies and distribution check are public.
!/scripts/
/scripts/*
!/scripts/check_distribution.py
!/scripts/live_harness.py
!/scripts/live_v2_final.py
!/scripts/live_final_cleanup.py
!/scripts/live_probe_run.py
!/scripts/final_cases/

# Generated files and secrets, including inside permitted directories.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
.env
.env.*
*.pem
*.key
bridge.json
*.log

# Personal Ableton projects, presets and audio.
*.als
*.alc
*.adg
*.adv
*.wav
*.aif
*.aiff
*.flac
*.mp3
!tests/fixtures/**
