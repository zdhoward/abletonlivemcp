[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "show/hide/focus a `view`, zoom/scroll it (`direction`), select a `target` (track,\nscene, clip -> detail clip, slot, device), audition a browser item (`root`+`path`) or\nstop_audition. Returns the readback (visible views or selection).",
  "inputSchema": {
   "$defs": {
    "ViewTarget": {
     "properties": {
      "kind": {
       "enum": [
        "track",
        "scene",
        "clip",
        "slot",
        "device"
       ],
       "type": "string"
      },
      "path": {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    }
   },
   "properties": {
    "action": {
     "enum": [
      "show",
      "hide",
      "focus",
      "zoom",
      "scroll",
      "select",
      "audition",
      "stop_audition"
     ],
     "type": "string"
    },
    "direction": {
     "enum": [
      "up",
      "down",
      "left",
      "right"
     ],
     "type": "string"
    },
    "path": {
     "items": {
      "type": "string"
     },
     "maxItems": 8,
     "minItems": 1,
     "type": "array"
    },
    "root": {
     "type": "string"
    },
    "target": {
     "$ref": "#/$defs/ViewTarget"
    },
    "view": {
     "enum": [
      "Browser",
      "Arranger",
      "Session",
      "Detail",
      "Detail/Clip",
      "Detail/DeviceChain"
     ],
     "type": "string"
    }
   },
   "required": [
    "action"
   ],
   "type": "object"
  },
  "name": "live_view",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_viewDictOutput",
   "type": "object"
  },
  "title": "View"
 }
]
