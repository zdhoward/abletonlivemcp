[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Create clips in empty Session slots: MIDI (length beats, optional notes) or audio (file:\nabsolute path, audio track). Returns readback with new note_ids. if_exists for an occupied\nslot: \"error\" (default; the whole batch is refused, nothing written), \"skip\" (leave that\nclip alone, create the rest; skipped slots are listed) or \"replace\" (delete the old clip\nfirst; needs the local \"delete\" permission). Re-running with skip or replace is idempotent.\nArrangement: live_create_arrangement_clips; from a .mid: live_import_midi.",
  "inputSchema": {
   "$defs": {
    "NewClip": {
     "additionalProperties": false,
     "properties": {
      "color_index": {
       "maximum": 69,
       "minimum": 0,
       "type": "integer"
      },
      "file": {
       "maxLength": 1024,
       "type": "string"
      },
      "kind": {
       "default": "midi",
       "enum": [
        "midi",
        "audio"
       ],
       "type": "string"
      },
      "length": {
       "default": 4.0,
       "exclusiveMinimum": 0,
       "maximum": 1024,
       "type": "number"
      },
      "name": {
       "maxLength": 256,
       "type": "string"
      },
      "notes": {
       "items": {
        "$ref": "#/$defs/Note"
       },
       "maxItems": 2000,
       "type": "array"
      },
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "type": "object"
    },
    "Note": {
     "additionalProperties": false,
     "properties": {
      "duration": {
       "exclusiveMinimum": 0,
       "maximum": 16384,
       "type": "number"
      },
      "mute": {
       "default": false,
       "type": "boolean"
      },
      "pitch": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      },
      "probability": {
       "default": 1,
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "release_velocity": {
       "default": 64,
       "maximum": 127,
       "minimum": 0,
       "type": "number"
      },
      "start_time": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      "velocity": {
       "default": 100,
       "maximum": 127,
       "minimum": 1,
       "type": "number"
      },
      "velocity_deviation": {
       "default": 0,
       "maximum": 127,
       "minimum": -127,
       "type": "number"
      }
     },
     "required": [
      "pitch",
      "start_time",
      "duration"
     ],
     "type": "object"
    }
   },
   "properties": {
    "clips": {
     "items": {
      "$ref": "#/$defs/NewClip"
     },
     "type": "array"
    },
    "if_exists": {
     "default": "error",
     "enum": [
      "error",
      "skip",
      "replace"
     ],
     "type": "string"
    }
   },
   "required": [
    "clips"
   ],
   "type": "object"
  },
  "name": "live_create_clips",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Create clips"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Clips by address, or scan Session clips (filter by track/scene; 128 rows max).\ndetail=True adds launch, audio and warp-marker fields.\nNote contents: live_get_notes.",
  "inputSchema": {
   "$defs": {
    "ArrangementClipAddr": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "type": "object"
    },
    "ClipAddr": {
     "additionalProperties": false,
     "properties": {
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "type": "object"
    }
   },
   "properties": {
    "clips": {
     "items": {
      "anyOf": [
       {
        "$ref": "#/$defs/ClipAddr"
       },
       {
        "$ref": "#/$defs/ArrangementClipAddr"
       }
      ]
     },
     "type": "array"
    },
    "detail": {
     "default": false,
     "type": "boolean"
    },
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "type": "string"
    },
    "scene": {
     "type": "integer"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    }
   },
   "type": "object"
  },
  "name": "live_get_clips",
  "outputSchema": {
   "$defs": {
    "Clips": {
     "additionalProperties": true,
     "properties": {
      "clips": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "truncated": {
       "type": "boolean"
      }
     },
     "required": [
      "clips",
      "truncated"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/Clips"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Get clips"
 },
 {
