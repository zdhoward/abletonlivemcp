       ]
      },
      "legato": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "loop": {
       "anyOf": [
        {
         "items": {
          "type": "number"
         },
         "maxItems": 2,
         "minItems": 2,
