         "type": "null"
        }
       ]
      },
      "looping": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "markers": {
       "anyOf": [
        {
         "items": {
          "type": "number"
         },
         "maxItems": 2,
         "minItems": 2,
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "muted": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 256,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
