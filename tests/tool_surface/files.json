[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Export a MIDI clip's notes (from beat 0 of the clip, Set tempo and signature) to a NEW\n.mid file (SMF 0; an existing file refuses). The file is written only after every page\ncame from one snapshot of the same clip, unchanged until the last page.",
  "inputSchema": {
   "$defs": {
    "ArrangementClipAddr": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "type": "object"
    },
    "ClipAddr": {
     "additionalProperties": false,
     "properties": {
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "type": "object"
    }
   },
   "properties": {
    "clip": {
     "anyOf": [
      {
       "$ref": "#/$defs/ClipAddr"
      },
      {
       "$ref": "#/$defs/ArrangementClipAddr"
      }
     ]
    },
    "file": {
     "type": "string"
    }
   },
   "required": [
    "clip",
    "file"
   ],
   "type": "object"
  },
  "name": "live_export_midi",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "bytes": {
     "type": "integer"
    },
    "file": {
     "type": "string"
    },
    "muted_skipped": {
     "type": "integer"
    },
    "notes": {
     "type": "integer"
    }
   },
   "required": [
    "file",
    "notes",
    "muted_skipped",
    "bytes"
   ],
   "type": "object"
  },
  "title": "Export midi"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Import a .mid (SMF 0/1, all tracks merged, first 1000 notes) as a new MIDI clip: in the\nempty Session slot `scene`, or in the arrangement at `start` beats. Length defaults to the\nnotes rounded up to a bar.",
  "inputSchema": {
   "properties": {
    "file": {
     "type": "string"
    },
    "length": {
     "exclusiveMinimum": 0,
     "maximum": 1024,
     "type": "number"
    },
    "name": {
     "maxLength": 256,
     "type": "string"
    },
    "scene": {
     "minimum": 0,
     "type": "integer"
    },
    "start": {
     "maximum": 16384,
     "minimum": 0,
     "type": "number"
    },
    "track": {
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "file",
    "track"
   ],
   "type": "object"
  },
  "name": "live_import_midi",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Import midi"
 }
]
