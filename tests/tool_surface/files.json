[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Export a MIDI clip's notes (from beat 0 of the clip, Set tempo and signature) to a NEW\n.mid file (SMF 0; an existing file refuses).",
  "inputSchema": {
   "$defs": {
    "ArrangementClipAddr": {
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "type": "object"
    },
    "ClipAddr": {
     "properties": {
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "type": "object"
    }
   },
   "properties": {
    "clip": {
     "anyOf": [
      {
       "$ref": "#/$defs/ClipAddr"
      },
      {
       "$ref": "#/$defs/ArrangementClipAddr"
      }
     ]
    },
    "file": {
     "type": "string"
    }
   },
   "required": [
    "clip",
    "file"
   ],
   "type": "object"
  },
  "name": "live_export_midi",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_export_midiDictOutput",
   "type": "object"
  },
  "title": "Export midi"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Import a .mid (SMF 0/1, all tracks merged, 2000 notes max) as a new MIDI clip: in the\nempty Session slot `scene`, or in the arrangement at `start` beats. Length defaults to the\nnotes rounded up to a bar.",
  "inputSchema": {
   "properties": {
    "file": {
     "type": "string"
    },
    "length": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "maximum": 1024,
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "name": {
     "anyOf": [
      {
       "maxLength": 256,
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "scene": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "start": {
     "anyOf": [
      {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "track": {
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "file",
    "track"
   ],
   "type": "object"
  },
  "name": "live_import_midi",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_import_midiDictOutput",
   "type": "object"
  },
  "title": "Import midi"
 }
]
