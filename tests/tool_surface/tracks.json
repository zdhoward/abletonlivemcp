      },
      "expect_name": {
       "maxLength": 256,
       "type": "string"
      },
      "fold": {
       "type": "boolean"
      },
      "input_routing": {
       "$ref": "#/$defs/Routing"
      },
      "monitoring": {
       "enum": [
        "in",
        "auto",
        "off"
       ],
       "type": "string"
      },
      "mute": {
       "type": "boolean"
      },
      "name": {
       "maxLength": 256,
       "type": "string"
      },
      "output_routing": {
       "$ref": "#/$defs/Routing"
      },
      "solo": {
       "type": "boolean"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track"
     ],
     "type": "object"
    }
   },
   "properties": {
    "targets": {
     "items": {
      "$ref": "#/$defs/TrackEdit"
     },
     "maxItems": 64,
     "minItems": 1,
     "title": "Targets",
     "type": "array"
    }
   },
   "required": [
    "targets"
   ],
   "title": "live_set_tracksArguments",
   "type": "object"
  },
  "name": "live_set_tracks",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_set_tracksDictOutput",
   "type": "object"
  },
  "title": "Set tracks"
 }
