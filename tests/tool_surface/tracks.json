 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Create midi/audio tracks at `index` (-1 = end) or return tracks (end), with optional\nname and color. Not idempotent. Receipt per item with the new TrackSel.",
  "inputSchema": {
   "$defs": {
    "NewTrack": {
     "additionalProperties": false,
     "properties": {
      "color_index": {
       "maximum": 69,
       "minimum": 0,
       "type": "integer"
      },
      "index": {
       "default": -1,
       "minimum": -1,
       "type": "integer"
      },
      "kind": {
       "enum": [
        "midi",
        "audio",
        "return"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 256,
       "type": "string"
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    }
   },
   "properties": {
    "tracks": {
     "items": {
      "$ref": "#/$defs/NewTrack"
     },
     "maxItems": 32,
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "tracks"
   ],
   "type": "object"
  },
  "name": "live_create_tracks",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    },
    "WriteReceipt": {
     "additionalProperties": true,
     "properties": {
      "applied": {
       "items": {},
       "type": "array"
      },
      "error": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "items": {
       "items": {
        "$ref": "#/$defs/ReceiptItem"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "complete",
        "partial"
       ],
       "type": "string"
      },
      "stopped_at": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "undo_steps": {
       "type": "integer"
      },
      "unverified": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "status",
      "items",
      "stopped_at",
      "error",
      "applied"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/WriteReceipt"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Create tracks"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Delete tracks, returns, scenes, clips or devices (mixed). Every target needs\nexpect_name; a human confirms the objects read from Live. Children are deleted before\nparents; no rollback.",
  "inputSchema": {
   "$defs": {
    "ClipAddr": {
     "additionalProperties": false,
     "properties": {
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ],
       "description": "Track index, \"return:N\" or \"master\""
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "type": "object"
    },
    "StructTarget": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "expect_name": {
       "maxLength": 256,
       "type": "string"
      },
      "kind": {
       "enum": [
        "track",
        "return",
        "scene",
        "clip",
        "device"
       ],
       "type": "string"
      },
      "path": {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "minimum": 0,
       "type": "integer"
      },
      "to": {
       "$ref": "#/$defs/ClipAddr"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ],
       "description": "Track index, \"return:N\" or \"master\""
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    }
   },
   "properties": {
    "targets": {
     "items": {
      "$ref": "#/$defs/StructTarget"
     },
     "maxItems": 64,
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "targets"
   ],
   "type": "object"
  },
  "name": "live_delete",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    },
    "StepReceipt": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "items": {
       "items": {
        "$ref": "#/$defs/ReceiptItem"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "complete",
        "partial"
       ],
       "type": "string"
      },
      "stopped_at": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "status",
      "items",
      "stopped_at",
      "error"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/StepReceipt"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Delete"
