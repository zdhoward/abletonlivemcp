[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Create midi/audio tracks at `index` (-1 = end) or return tracks (end), with optional\nname and color. Not idempotent. Receipt per item with the new TrackSel.",
  "inputSchema": {
   "$defs": {
    "NewTrack": {
     "additionalProperties": false,
     "properties": {
      "color_index": {
       "maximum": 69,
       "minimum": 0,
       "type": "integer"
      },
      "index": {
       "default": -1,
       "minimum": -1,
       "type": "integer"
      },
      "kind": {
       "enum": [
        "midi",
        "audio",
        "return"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 256,
       "type": "string"
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    }
   },
   "properties": {
    "tracks": {
     "items": {
      "$ref": "#/$defs/NewTrack"
     },
     "maxItems": 64,
     "minItems": 1,
     "title": "Tracks",
     "type": "array"
    }
   },
   "required": [
    "tracks"
   ],
   "title": "live_create_tracksArguments",
   "type": "object"
  },
  "name": "live_create_tracks",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_create_tracksDictOutput",
   "type": "object"
  },
  "title": "Create tracks"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Delete tracks, returns, scenes, clips or devices (mixed). Every target needs\nexpect_name; a human confirms. Children are deleted before parents; no rollback.",
  "inputSchema": {
   "$defs": {
    "ClipAddr": {
     "additionalProperties": false,
     "description": "A Session clip slot.",
     "properties": {
      "scene": {
       "minimum": 0,
       "title": "Scene",
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ],
       "title": "Track"
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "title": "ClipAddr",
     "type": "object"
    },
    "StructTarget": {
     "additionalProperties": false,
     "description": "track: track=N; return: track=\"return:N\"; scene: scene; clip: track+scene or\ntrack+arrangement[+take_lane]; device: track+path. `to`: clip duplicate destination.",
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "expect_name": {
       "maxLength": 256,
       "type": "string"
      },
      "kind": {
       "enum": [
        "track",
        "return",
        "scene",
        "clip",
        "device"
       ],
       "type": "string"
      },
      "path": {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "minimum": 0,
       "type": "integer"
      },
      "to": {
       "$ref": "#/$defs/ClipAddr"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    }
   },
   "properties": {
    "targets": {
     "items": {
      "$ref": "#/$defs/StructTarget"
     },
     "maxItems": 64,
     "minItems": 1,
     "title": "Targets",
     "type": "array"
    }
   },
   "required": [
    "targets"
   ],
   "title": "live_deleteArguments",
   "type": "object"
  },
  "name": "live_delete",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_deleteDictOutput",
   "type": "object"
  },
  "title": "Delete"
 },
