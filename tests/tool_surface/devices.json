[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "No path, or a path ending at a chain index or \"pad:N\": list the devices there. A path\nending at a device ([d] or [d, chain, d, ...]): the device header and its parameters\n(value, range, display, items, default), paged (limit <= 128). track: index, \"return:N\"\nor \"master\". Rack macros and chains: live_get_rack; drum pads: live_get_drum_rack\n(opt-in toolsets).",
  "inputSchema": {
   "properties": {
    "limit": {
     "default": 128,
     "type": "integer"
    },
    "offset": {
     "default": 0,
     "type": "integer"
    },
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "type": "string"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ],
     "description": "Track index, \"return:N\" or \"master\""
    }
   },
   "required": [
    "track"
   ],
   "type": "object"
  },
  "name": "live_get_device_parameters",
  "outputSchema": {
   "$defs": {
    "DeviceListing": {
     "additionalProperties": true,
     "properties": {
      "container": {
       "type": "string"
      },
      "container_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "devices": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "owner": {
       "additionalProperties": true,
       "type": "object"
      }
     },
     "required": [
      "owner",
      "container",
      "container_name",
      "devices"
     ],
     "type": "object"
    },
    "ParameterPage": {
     "additionalProperties": true,
     "properties": {
      "device": {
       "additionalProperties": true,
       "type": "object"
      },
      "next_offset": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "parameters": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "parameters",
      "next_offset"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "anyOf": [
      {
       "$ref": "#/$defs/DeviceListing"
      },
      {
       "$ref": "#/$defs/ParameterPage"
      }
     ]
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Get device parameters"
 },
 {
