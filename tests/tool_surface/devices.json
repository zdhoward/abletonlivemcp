  "description": "No path, or a path ending at a chain index or \"pad:N\": list the devices there. A path\nending at a device ([d] or [d, chain, d, ...]): its parameters (value, range, display,\nitems, default), paged (limit <= 128). track: index, \"return:N\" or \"master\".",
  "inputSchema": {
   "properties": {
    "limit": {
     "default": 128,
     "title": "Limit",
     "type": "integer"
    },
    "offset": {
     "default": 0,
     "title": "Offset",
     "type": "integer"
    },
    "path": {
     "anyOf": [
      {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Path"
    },
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "title": "Response Format",
     "type": "string"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ],
     "title": "Track"
    }
   },
   "required": [
    "track"
   ],
   "title": "live_get_device_parametersArguments",
   "type": "object"
  },
  "name": "live_get_device_parameters",
  "outputSchema": {
   "additionalProperties": true,
