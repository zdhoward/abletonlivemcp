 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Turn devices on/off, rename or collapse them (1..64 targets, each its track + path to a\ndevice; optional expect_name). All are validated before any write; the receipt has\nper-item outcomes and `unverified` abilities.\nParameter values: live_set_device_parameters.",
  "inputSchema": {
   "$defs": {
    "DeviceEdit": {
     "additionalProperties": false,
     "properties": {
      "collapsed": {
       "type": "boolean"
      },
      "expect_name": {
       "maxLength": 256,
       "type": "string"
      },
      "name": {
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "on": {
       "type": "boolean"
      },
      "path": {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ],
       "description": "Track index, \"return:N\" or \"master\""
      }
     },
     "required": [
      "track",
      "path"
     ],
     "type": "object"
    }
   },
   "properties": {
    "targets": {
     "items": {
      "$ref": "#/$defs/DeviceEdit"
     },
     "type": "array"
    }
   },
   "required": [
    "targets"
   ],
   "type": "object"
  },
  "name": "live_set_devices",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Set devices"
 }
