  "inputSchema": {
   "properties": {
    "expect_name": {
     "type": "string"
    },
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "position": {
     "type": "integer"
    },
    "to_path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "to_track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ],
     "description": "Track index, \"return:N\" or \"master\""
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ],
     "description": "Track index, \"return:N\" or \"master\""
    }
   },
   "required": [
    "track",
    "path",
    "to_track"
   ],
   "type": "object"
  },
  "name": "live_move_device",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "devices": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "moved": {
     "type": "string"
    },
    "position": {
     "type": "integer"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "moved",
    "position",
    "devices",
    "provenance"
   ],
   "type": "object"
  },
  "title": "Move device"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set 1..32 parameters of one device, by name or index. value: a display target (\"-18 dB\",\n4, \"Vocal\", true) solved against Live's display, or {\"raw\": x}; or reset (default) or\nre_enable_automation. Results show actual vs requested and `exact`. Disabled or\nmacro-controlled parameters are refused.\nOn/off or rename: live_set_devices; rack macros: live_set_rack (racks toolset).",
  "inputSchema": {
   "$defs": {
    "ParamWrite": {
     "additionalProperties": false,
     "properties": {
      "parameter": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "integer"
        }
       ]
      },
      "re_enable_automation": {
       "default": false,
       "type": "boolean"
      },
      "reset": {
       "default": false,
       "type": "boolean"
      },
      "value": {
       "anyOf": [
        {
         "$ref": "#/$defs/RawValue"
        },
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      }
     },
     "required": [
      "parameter"
     ],
     "type": "object"
    },
    "RawValue": {
     "additionalProperties": false,
     "properties": {
      "raw": {
       "type": "number"
      }
     },
     "required": [
      "raw"
     ],
     "type": "object"
    }
   },
   "properties": {
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "settings": {
     "items": {
      "$ref": "#/$defs/ParamWrite"
     },
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ],
     "description": "Track index, \"return:N\" or \"master\""
    }
   },
   "required": [
    "track",
    "path",
    "settings"
   ],
   "type": "object"
  },
  "name": "live_set_device_parameters",
  "outputSchema": {
   "$defs": {
    "ParameterResult": {
     "additionalProperties": true,
     "properties": {
      "actual": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "actual_raw": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "exact": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "off_target": {
       "type": "boolean"
      },
      "original": {
       "additionalProperties": true,
       "type": "object"
      },
      "raw": {
       "type": "boolean"
      },
      "requested": {}
     },
     "required": [
      "name",
