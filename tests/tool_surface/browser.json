 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Search one browser root by name in a bounded slice. Check `complete`/`truncated`/\n`budget_exhausted`: an incomplete search is unknown, never 'not installed'.",
  "inputSchema": {
   "properties": {
    "cursor": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cursor"
    },
    "limit": {
     "default": 25,
     "title": "Limit",
     "type": "integer"
    },
    "query": {
     "title": "Query",
     "type": "string"
    },
    "root": {
     "title": "Root",
     "type": "string"
    }
   },
   "required": [
    "root",
    "query"
   ],
   "title": "live_browser_searchArguments",
   "type": "object"
  },
  "name": "live_browser_search",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_browser_searchDictOutput",
   "type": "object"
  },
  "title": "Browser search"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Read a load/task operation (pending, ready, failed, unknown), or up to 16 at once with\n`operations`. Use after a lost response; never start a second load for the same target.",
  "inputSchema": {
   "properties": {
    "operation": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Operation"
    },
    "operations": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Operations"
    }
   },
   "title": "live_get_operationArguments",
   "type": "object"
  },
  "name": "live_get_operation",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_get_operationDictOutput",
   "type": "object"
  },
  "title": "Get operation"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Load one browser item onto a track, return or master, or into a rack chain or drum pad\n(target_path ends at a chain index or \"pad:N\"). Sources need an empty MIDI container;\neffects need an empty one, append=true, or after=<the previous ready load>. Placement is\nchecked by identity; unknown quarantines the target. Poll live_get_operation, never reload.",
  "inputSchema": {
   "properties": {
    "after": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "After"
    },
    "append": {
     "default": false,
     "title": "Append",
     "type": "boolean"
    },
    "path": {
     "items": {
      "type": "string"
     },
     "title": "Path",
     "type": "array"
    },
    "root": {
     "title": "Root",
     "type": "string"
    },
    "target_path": {
     "anyOf": [
      {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Target Path"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ],
     "title": "Track"
    }
   },
   "required": [
    "track",
    "root",
    "path"
   ],
   "title": "live_load_itemArguments",
   "type": "object"
  },
  "name": "live_load_item",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_load_itemDictOutput",
   "type": "object"
  },
  "title": "Load item"
 }
]
