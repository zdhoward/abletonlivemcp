 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Load one item discovered with live_browser_list/search; use live_plan_chain for a stack.\nTarget: track, return, master, rack chain or drum pad\n(target_path ends at a chain index or \"pad:N\"). Sources need an empty MIDI container;\neffects need an empty one, append=true, or after=<the previous ready load>. Placement is\nchecked by identity; unknown quarantines the target. Poll live_get_operation, never reload.",
  "inputSchema": {
   "properties": {
    "after": {
     "type": "string"
    },
    "append": {
     "default": false,
     "type": "boolean"
    },
    "path": {
     "items": {
      "type": "string"
     },
     "maxItems": 8,
     "minItems": 1,
     "type": "array"
    },
    "root": {
     "type": "string"
    },
    "target_path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    }
   },
   "required": [
    "track",
    "root",
    "path"
   ],
   "type": "object"
  },
  "name": "live_load_item",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "applied": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ]
    },
    "device": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "generation": {
     "type": "integer"
    },
    "kind": {
     "type": "string"
    },
    "may_have_applied": {
     "type": "boolean"
    },
    "operation": {
     "type": "string"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "result": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    },
    "state": {
     "enum": [
      "pending",
      "ready",
      "failed",
      "unknown",
      "unknown_operation"
     ],
     "type": "string"
    }
   },
   "required": [
    "operation",
    "state"
   ],
   "type": "object"
  },
  "title": "Load item"
 }
