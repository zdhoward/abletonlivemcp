     "default": null,
     "title": "Cursor"
    },
    "limit": {
     "default": 200,
     "title": "Limit",
     "type": "integer"
    },
    "path": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Path"
    },
    "root": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Root"
    }
   },
   "title": "live_browser_listArguments",
   "type": "object"
  },
  "name": "live_browser_list",
  "outputSchema": {
   "additionalProperties": true,
