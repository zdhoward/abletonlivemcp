 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Edit pads of a Drum Rack (by note): mute, solo, name, choke_group, clear (needs the pad's\ncurrent expect_name); or copy one pad onto an EMPTY pad. Validated before any write.",
  "inputSchema": {
   "$defs": {
    "PadCopy": {
     "additionalProperties": false,
     "properties": {
      "destination": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      },
      "source": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "source",
      "destination"
     ],
     "type": "object"
    },
    "PadEdit": {
     "additionalProperties": false,
     "properties": {
      "choke_group": {
       "maximum": 16,
       "minimum": 0,
       "type": "integer"
      },
      "clear": {
       "default": false,
       "type": "boolean"
      },
      "expect_name": {
       "description": "required with clear: the pad's current name",
       "maxLength": 256,
       "type": "string"
      },
      "mute": {
       "type": "boolean"
      },
      "name": {
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "note": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      },
      "solo": {
       "type": "boolean"
      }
     },
     "required": [
      "note"
     ],
     "type": "object"
    }
   },
   "properties": {
    "copy": {
     "$ref": "#/$defs/PadCopy"
    },
    "pads": {
     "items": {
      "$ref": "#/$defs/PadEdit"
     },
     "type": "array"
    },
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    }
   },
   "required": [
    "track",
    "path"
   ],
   "type": "object"
  },
  "name": "live_set_drum_pads",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Set drum pads"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set Simpler fields (playback_mode, voices, retrigger, ...), sample fields (start_marker,\nend_marker, gain, warping, warp_mode, slicing_*) and slices (insert/remove sample times,\nclear, reset). Validated first; the receipt says how far it got.",
