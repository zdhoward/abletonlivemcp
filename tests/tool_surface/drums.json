        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "path": {
       "items": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "string"
         }
        ]
       },
       "type": "array"
      },
      "track": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "path",
      "kind",
      "name",
      "generation",
      "devices"
     ],
     "type": "object"
