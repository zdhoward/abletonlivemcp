[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Build a live_plan_drum_rack plan exactly once (Set and target re-checked). Stops at the\nfirst pad not observed; never retries, deletes or substitutes. Reuse returns the receipt.",
  "inputSchema": {
   "properties": {
    "plan_id": {
     "type": "string"
    }
   },
   "required": [
    "plan_id"
   ],
   "type": "object"
  },
  "name": "live_build_drum_rack",
  "outputSchema": {
   "$defs": {
    "PlanTarget": {
     "additionalProperties": true,
     "properties": {
      "devices": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "generation": {
       "type": "integer"
      },
      "kind": {
       "type": "string"
      },
      "name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "path": {
       "items": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "string"
         }
        ]
       },
       "type": "array"
      },
      "track": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "path",
      "kind",
      "name",
      "generation",
      "devices"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "already_built": {
     "type": "boolean"
    },
    "completed": {
     "items": {
      "type": "integer"
     },
     "type": "array"
    },
    "intent_fulfilled": {
     "type": "boolean"
    },
    "manual_steps": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "mode": {
     "type": "string"
    },
    "omitted": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "plan_id": {
     "type": "string"
    },
    "stages": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial",
      "failed",
      "pending"
     ],
     "type": "string"
    },
    "stop_reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "target": {
     "$ref": "#/$defs/PlanTarget"
    },
    "unknown": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "plan_id",
    "mode",
    "status",
    "intent_fulfilled",
    "target",
    "completed",
    "stopped_at",
    "stop_reason",
    "omitted",
    "unknown",
    "stages",
    "unverified",
    "manual_steps"
   ],
   "type": "object"
  },
  "title": "Build drum rack"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Run one Live conversion (adds tracks/devices; nothing is deleted): audio_to_midi\n(midi_type), drum_rack_from_audio_clip, simpler_from_audio_clip, midi_track_from_drum_pad,\nsliced_simpler_to_drum_rack, devices_to_drum_pad. Re-read tracks afterwards.",
  "inputSchema": {
   "$defs": {
    "ConvertTarget": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "path": {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track"
     ],
     "type": "object"
    }
   },
   "properties": {
    "action": {
     "enum": [
      "audio_to_midi",
      "drum_rack_from_audio_clip",
      "simpler_from_audio_clip",
      "midi_track_from_drum_pad",
      "sliced_simpler_to_drum_rack",
      "devices_to_drum_pad"
     ],
     "type": "string"
    },
    "midi_type": {
     "default": "melody",
     "enum": [
      "drums",
      "harmony",
      "melody"
     ],
     "type": "string"
    },
    "target": {
     "$ref": "#/$defs/ConvertTarget"
    }
   },
   "required": [
    "action",
    "target"
   ],
   "type": "object"
  },
  "name": "live_convert",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "action": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "returned": {},
    "tracks_after": {
     "type": "integer"
    },
    "tracks_before": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "action",
    "tracks_before",
    "tracks_after",
    "returned",
    "unverified",
    "note"
   ],
   "type": "object"
  },
  "title": "Convert"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Pads of a Drum Rack (path to the rack device): note, name, mute/solo, chain devices,\nchoke group. include_empty lists all 128 pads.",
  "inputSchema": {
   "properties": {
    "include_empty": {
     "default": false,
     "type": "boolean"
    },
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    }
   },
   "required": [
    "track",
    "path"
   ],
   "type": "object"
  },
  "name": "live_get_drum_rack",
  "outputSchema": {
   "$defs": {
    "DrumRack": {
     "additionalProperties": true,
     "properties": {
      "chains": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "pads": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "selected_note": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "pads",
      "selected_note",
      "chains"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/DrumRack"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Get drum rack"
 },
 {
