  "description": "Build a live_plan_drum_rack plan exactly once (Set and target re-checked). Stops at the\nfirst pad not observed; never retries, deletes or substitutes. Reuse returns the receipt.",
  "inputSchema": {
   "properties": {
    "plan_id": {
     "title": "Plan Id",
     "type": "string"
    }
   },
   "required": [
    "plan_id"
   ],
   "title": "live_build_drum_rackArguments",
   "type": "object"
  },
  "name": "live_build_drum_rack",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_build_drum_rackDictOutput",
   "type": "object"
  },
  "title": "Build drum rack"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Run one Live conversion (adds tracks/devices; nothing is deleted): audio_to_midi\n(midi_type), drum_rack_from_audio_clip, simpler_from_audio_clip, midi_track_from_drum_pad,\nsliced_simpler_to_drum_rack, devices_to_drum_pad. Re-read tracks afterwards.",
  "inputSchema": {
   "$defs": {
    "ConvertTarget": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Arrangement"
      },
      "path": {
       "anyOf": [
        {
         "items": {
          "anyOf": [
           {
            "minimum": 0,
            "type": "integer"
           },
           {
            "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
            "type": "string"
           }
          ]
         },
         "maxItems": 12,
         "minItems": 1,
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Path"
      },
      "scene": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Scene"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ],
       "title": "Track"
      }
     },
     "required": [
      "track"
     ],
     "title": "ConvertTarget",
     "type": "object"
    }
   },
   "properties": {
    "action": {
     "enum": [
      "audio_to_midi",
      "drum_rack_from_audio_clip",
      "simpler_from_audio_clip",
      "midi_track_from_drum_pad",
      "sliced_simpler_to_drum_rack",
      "devices_to_drum_pad"
     ],
     "title": "Action",
     "type": "string"
    },
    "midi_type": {
     "default": "melody",
     "enum": [
      "drums",
      "harmony",
      "melody"
     ],
     "title": "Midi Type",
     "type": "string"
    },
    "target": {
     "$ref": "#/$defs/ConvertTarget"
    }
   },
   "required": [
    "action",
    "target"
   ],
   "title": "live_convertArguments",
   "type": "object"
  },
  "name": "live_convert",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_convertDictOutput",
   "type": "object"
  },
  "title": "Convert"
 },
