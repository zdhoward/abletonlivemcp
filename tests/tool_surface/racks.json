    },
    "WriteReceipt": {
     "additionalProperties": true,
     "properties": {
      "applied": {
       "items": {},
       "type": "array"
      },
      "error": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "items": {
       "items": {
        "$ref": "#/$defs/ReceiptItem"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "complete",
        "partial"
       ],
       "type": "string"
      },
      "stopped_at": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "undo_steps": {
       "type": "integer"
      },
      "unverified": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "status",
      "items",
      "stopped_at",
      "error",
      "applied"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "macros": {
     "items": {
      "$ref": "#/$defs/ParameterResult"
     },
     "type": "array"
    },
    "problems": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "rack": {
     "$ref": "#/$defs/WriteReceipt"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    }
   },
   "required": [
    "status"
   ],
   "type": "object"
  },
  "title": "Set rack"
 }
