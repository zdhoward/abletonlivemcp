[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "A rack's macros (value, display), variations and chains (devices, mute/solo, volume,\npan). Macro mapping is manual in Live; the reply says how.",
  "inputSchema": {
   "properties": {
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    }
   },
   "required": [
    "track",
    "path"
   ],
   "type": "object"
  },
  "name": "live_get_rack",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_get_rackDictOutput",
   "type": "object"
  },
  "title": "Get rack"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set macro values (\"50 %\", {\"raw\": x}), visible macro count, store/recall/delete/randomize a\nvariation, and chain name/mute/solo/volume/pan (raw). Rack state is validated before any\nwrite; macros are written last. Receipt lists `unverified` abilities.",
  "inputSchema": {
   "$defs": {
    "ChainEdit": {
     "properties": {
      "index": {
       "minimum": 0,
       "type": "integer"
      },
      "mute": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 256,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "pan": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "solo": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "volume": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "index"
     ],
     "type": "object"
    },
    "MacroSet": {
     "properties": {
      "macro": {
       "maximum": 16,
       "minimum": 1,
       "type": "integer"
      },
      "value": {
       "anyOf": [
        {
         "$ref": "#/$defs/RawValue"
        },
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      }
     },
     "required": [
      "macro",
      "value"
     ],
     "type": "object"
    },
    "RawValue": {
     "properties": {
      "raw": {
       "type": "number"
      }
     },
     "required": [
      "raw"
     ],
     "type": "object"
    },
    "Variation": {
     "properties": {
      "action": {
       "enum": [
        "store",
        "recall",
        "delete",
        "randomize"
       ],
       "type": "string"
      },
      "index": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    }
   },
   "properties": {
    "chains": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/ChainEdit"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "macros": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/MacroSet"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    },
    "variation": {
     "anyOf": [
      {
       "$ref": "#/$defs/Variation"
      },
      {
       "type": "null"
      }
     ]
    },
    "visible_macros": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "track",
    "path"
   ],
   "type": "object"
  },
  "name": "live_set_rack",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_set_rackDictOutput",
   "type": "object"
  },
  "title": "Set rack"
 }
]
