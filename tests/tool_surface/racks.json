   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "A rack's macros (value, display), variations and chains (devices, mute/solo, volume,\npan). Macro mapping is manual in Live; the reply says how.",
  "inputSchema": {
   "properties": {
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    }
   },
   "required": [
    "track",
    "path"
   ],
   "type": "object"
  },
  "name": "live_get_rack",
  "outputSchema": {
   "$defs": {
    "Rack": {
     "additionalProperties": true,
     "properties": {
      "chains": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "chains_truncated": {
       "type": "boolean"
      },
      "class_name": {
       "type": "string"
      },
      "drum_rack": {
       "type": "boolean"
      },
      "macros": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "mapping": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "class_name",
      "drum_rack",
      "macros",
      "chains",
      "chains_truncated",
      "mapping"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/Rack"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Get rack"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set macro values (\"50 %\", {\"raw\": x}), visible macro count, store/recall/delete/randomize a\nvariation, and chain name/mute/solo/volume/pan (raw). Rack state is validated before any\nwrite; macros are written last. Receipt lists `unverified` abilities.",
  "inputSchema": {
   "$defs": {
    "ChainEdit": {
     "additionalProperties": false,
     "properties": {
      "index": {
       "minimum": 0,
       "type": "integer"
      },
      "mute": {
       "type": "boolean"
      },
      "name": {
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "pan": {
       "type": "number"
      },
      "solo": {
       "type": "boolean"
      },
      "volume": {
       "type": "number"
      }
     },
     "required": [
      "index"
     ],
     "type": "object"
    },
    "MacroSet": {
     "additionalProperties": false,
     "properties": {
      "macro": {
       "maximum": 16,
       "minimum": 1,
       "type": "integer"
      },
      "value": {
       "anyOf": [
        {
         "$ref": "#/$defs/RawValue"
        },
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      }
     },
     "required": [
      "macro",
      "value"
     ],
     "type": "object"
    },
    "RawValue": {
     "additionalProperties": false,
     "properties": {
      "raw": {
       "type": "number"
      }
     },
     "required": [
      "raw"
     ],
     "type": "object"
    },
    "Variation": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "store",
        "recall",
        "delete",
        "randomize"
       ],
       "type": "string"
      },
      "index": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    }
   },
   "properties": {
    "chains": {
     "items": {
      "$ref": "#/$defs/ChainEdit"
     },
     "type": "array"
    },
    "macros": {
     "items": {
      "$ref": "#/$defs/MacroSet"
     },
     "type": "array"
    },
    "path": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
        "type": "string"
       }
      ]
     },
     "maxItems": 12,
     "minItems": 1,
     "type": "array"
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    },
    "variation": {
     "$ref": "#/$defs/Variation"
    },
    "visible_macros": {
     "type": "integer"
    }
   },
   "required": [
    "track",
    "path"
   ],
   "type": "object"
  },
  "name": "live_set_rack",
  "outputSchema": {
   "$defs": {
    "ParameterResult": {
     "additionalProperties": true,
     "properties": {
      "actual": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "actual_raw": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "exact": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "off_target": {
       "type": "boolean"
      },
      "original": {
       "additionalProperties": true,
       "type": "object"
      },
      "raw": {
       "type": "boolean"
      },
      "requested": {}
     },
     "required": [
      "name",
      "requested",
      "actual",
      "actual_raw",
      "exact",
      "off_target",
      "raw"
     ],
     "type": "object"
    },
    "ReceiptItem": {
     "additionalProperties": true,
