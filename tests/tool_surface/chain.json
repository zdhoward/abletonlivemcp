[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Build a live_plan_chain plan exactly once after re-checking the Set and target. Stops at\nthe first stage not fully applied and exact; receipt: status, intent_fulfilled, per-stage\noriginals/actuals, stopped_at, omitted, unknown, manual_steps. Never deletes, undoes,\nretries or substitutes. Reusing a plan returns its receipt.",
  "inputSchema": {
   "properties": {
    "accept_omissions": {
     "default": false,
     "type": "boolean"
    },
    "plan_id": {
     "type": "string"
    }
   },
   "required": [
    "plan_id"
   ],
   "type": "object"
  },
  "name": "live_build_chain",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_build_chainDictOutput",
   "type": "object"
  },
  "title": "Build chain"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Dry run. Target: track, return, master or a chain/pad (chain_path); occupied needs\nappend. Stage: {\"role\": eq|compressor|saturation|reverb, \"intent\"} or {\"device\", \"params\",\n\"root\"?, \"path\"?}; instruments first, empty MIDI target only. Value \"-18 dB\" or {\"raw\": x}.\nrack {\"groups\": [{macro, label?, value?, targets: [{device, parameter, min?, max?}]}]}\nwraps the existing effects in an Audio Effect Rack (manual mapping steps).",
  "inputSchema": {
   "properties": {
    "append": {
     "default": false,
     "type": "boolean"
    },
    "chain_path": {
     "anyOf": [
      {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
          "type": "string"
         }
        ]
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "preferences": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    },
    "rack": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    },
    "stages": {
     "anyOf": [
      {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "track": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
       "type": "string"
      }
     ]
    }
   },
   "required": [
    "track"
   ],
   "type": "object"
  },
  "name": "live_plan_chain",
  "outputSchema": {
   "additionalProperties": true,
   "title": "live_plan_chainDictOutput",
   "type": "object"
  },
  "title": "Plan chain"
 }
]
