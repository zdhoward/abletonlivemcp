[
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Edit one clip in order: fields, warp_markers (add needs sample_time seconds and an\nexisting marker; move by distance beats; remove at beat_time), crop, duplicate_loop\n(MIDI too). Receipt plus clip and marker readback.",
  "inputSchema": {
   "$defs": {
    "ArrangementClipAddr": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "type": "object"
    },
    "ClipAddr": {
     "additionalProperties": false,
     "properties": {
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "type": "object"
    },
    "WarpOp": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "add",
        "move",
        "remove"
       ],
       "type": "string"
      },
      "beat_time": {
       "type": "number"
      },
      "distance": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "sample_time": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "action",
      "beat_time"
     ],
     "type": "object"
    }
   },
   "properties": {
    "clip": {
     "anyOf": [
      {
       "$ref": "#/$defs/ClipAddr"
      },
      {
       "$ref": "#/$defs/ArrangementClipAddr"
      }
     ]
    },
    "crop": {
     "default": false,
     "type": "boolean"
    },
    "duplicate_loop": {
     "default": false,
     "type": "boolean"
    },
    "expect_name": {
     "anyOf": [
      {
       "maxLength": 256,
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "gain": {
     "anyOf": [
      {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "pitch_coarse": {
     "anyOf": [
      {
       "maximum": 48,
       "minimum": -48,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "pitch_fine": {
     "anyOf": [
      {
       "maximum": 50,
       "minimum": -50,
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "warp_markers": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/WarpOp"
       },
       "maxItems": 32,
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "warp_mode": {
     "anyOf": [
      {
       "enum": [
        "beats",
        "tones",
        "texture",
        "re_pitch",
        "complex",
        "rex",
        "complex_pro"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "warping": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "clip"
   ],
   "type": "object"
  },
  "name": "live_edit_audio_clip",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Edit audio clip"
 }
]
