 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set tempo (BPM), signature [num, den], metronome, loop/punch (beats), scale, groove\n(amount, swing, pool amounts), quantization (Live enum indices), Link. All validated\nbefore any write; each value is read back. count_in is read-only on Live 12.2.",
  "inputSchema": {
   "$defs": {
    "Groove": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "maximum": 1.3125,
       "minimum": 0,
       "type": "number"
      },
      "pool": {
       "items": {
        "$ref": "#/$defs/GrooveEdit"
       },
       "maxItems": 64,
       "minItems": 1,
       "type": "array"
      },
      "swing": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      }
     },
     "type": "object"
    },
    "GrooveEdit": {
     "additionalProperties": false,
     "properties": {
      "expect_name": {
       "maxLength": 256,
       "type": "string"
      },
      "index": {
       "minimum": 0,
       "type": "integer"
      },
      "quantization_amount": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "random_amount": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "timing_amount": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "velocity_amount": {
       "maximum": 100,
       "minimum": -100,
       "type": "number"
      }
     },
     "required": [
      "index"
     ],
     "type": "object"
    },
    "Link": {
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "start_stop_sync": {
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "Loop": {
     "additionalProperties": false,
     "properties": {
      "length": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "on": {
       "type": "boolean"
      },
      "punch_in": {
       "type": "boolean"
      },
      "punch_out": {
       "type": "boolean"
      },
      "start": {
       "minimum": 0,
       "type": "number"
      }
     },
     "type": "object"
    },
    "Quantization": {
     "additionalProperties": false,
     "properties": {
      "clip_trigger": {
       "maximum": 13,
       "minimum": 0,
       "type": "integer"
      },
      "midi_recording": {
       "maximum": 8,
       "minimum": 0,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "Scale": {
     "additionalProperties": false,
     "properties": {
      "root_note": {
       "maximum": 11,
       "minimum": 0,
       "type": "integer"
      },
      "scale_mode": {
       "type": "boolean"
      },
      "scale_name": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      }
     },
     "type": "object"
    }
   },
   "properties": {
    "count_in": {
     "type": "integer"
    },
    "groove": {
     "$ref": "#/$defs/Groove"
    },
    "link": {
     "$ref": "#/$defs/Link"
    },
    "loop": {
     "$ref": "#/$defs/Loop"
    },
    "metronome": {
     "type": "boolean"
    },
    "quantization": {
     "$ref": "#/$defs/Quantization"
    },
    "scale": {
     "$ref": "#/$defs/Scale"
    },
    "signature": {
     "items": {
      "maximum": 99,
      "minimum": 1,
      "type": "integer"
     },
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    },
    "tempo": {
     "maximum": 999,
     "minimum": 20,
     "type": "number"
    }
   },
   "type": "object"
  },
  "name": "live_set_session",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    },
    "WriteReceipt": {
     "additionalProperties": true,
     "properties": {
      "applied": {
       "items": {},
       "type": "array"
      },
      "error": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "items": {
       "items": {
        "$ref": "#/$defs/ReceiptItem"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "complete",
        "partial"
       ],
       "type": "string"
      },
      "stopped_at": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "undo_steps": {
       "type": "integer"
      },
      "unverified": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "status",
      "items",
      "stopped_at",
      "error",
      "applied"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/WriteReceipt"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Set session"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Transport: play, stop, continue, stop_all_clips, jump_to/jump_by (`beats`), cue jumps,\ntap_tempo, nudge, back_to_arranger. Returns the state read after Live settles.\nClips and scenes: live_launch.",
  "inputSchema": {
   "properties": {
    "action": {
     "enum": [
      "play",
      "stop",
      "continue",
      "stop_all_clips",
      "jump_to",
      "jump_by",
      "next_cue",
      "prev_cue",
      "tap_tempo",
      "nudge_up",
      "nudge_down",
      "back_to_arranger"
     ],
     "type": "string"
    },
    "beats": {
     "type": "number"
    }
   },
   "required": [
    "action"
   ],
   "type": "object"
  },
  "name": "live_transport",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "action": {
     "type": "string"
    },
    "current_song_time": {
     "type": "number"
    },
    "is_playing": {
     "type": "boolean"
    },
    "settled": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    },
    "tempo": {
     "type": "number"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "verification": {
     "type": "string"
    }
   },
   "required": [
    "action",
    "unverified",
    "is_playing",
    "current_song_time",
    "tempo",
    "settled"
   ],
   "type": "object"
  },
  "title": "Transport"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Undo or redo 1..10 steps of Live's history (each tool write is one step). Stops early\nwhen history runs out; reports done/requested.",
  "inputSchema": {
   "properties": {
    "action": {
     "default": "undo",
     "enum": [
      "undo",
      "redo"
     ],
     "type": "string"
    },
    "steps": {
     "default": 1,
     "maximum": 10,
     "minimum": 1,
     "type": "integer"
    }
   },
   "type": "object"
  },
  "name": "live_undo",
  "outputSchema": {
   "additionalProperties": true,
   "properties": {
    "action": {
     "enum": [
      "undo",
      "redo"
     ],
     "type": "string"
    },
    "can_redo": {
     "type": "boolean"
    },
    "can_undo": {
     "type": "boolean"
    },
    "done": {
     "type": "integer"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "requested": {
     "type": "integer"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    }
   },
   "required": [
    "action",
    "requested",
    "done",
    "status",
    "error",
    "can_undo",
    "can_redo"
   ],
   "type": "object"
  },
  "title": "Undo"
 }
]
