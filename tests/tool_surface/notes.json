         "type": "string"
        }
       ],
       "description": "Track index, \"return:N\" or \"master\""
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "type": "object"
    },
    "ClipAddr": {
     "additionalProperties": false,
     "properties": {
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
