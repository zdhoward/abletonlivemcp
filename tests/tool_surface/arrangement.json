[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "New arrangement clips at `start` beats: MIDI (length, notes) or audio (absolute file;\nplaced after the track's last clip). Overlaps refuse. from_session and take_lane refuse on\nLive 12.2 (crash risk).",
  "inputSchema": {
   "$defs": {
    "NewArrangementClip": {
     "additionalProperties": false,
     "properties": {
      "file": {
       "anyOf": [
        {
         "maxLength": 1024,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "default": "midi",
       "enum": [
        "midi",
        "audio",
        "from_session"
       ],
       "type": "string"
      },
      "length": {
       "default": 4.0,
       "exclusiveMinimum": 0,
       "maximum": 1024,
       "type": "number"
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 256,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "notes": {
       "anyOf": [
        {
         "items": {
          "$ref": "#/$defs/Note"
         },
         "maxItems": 2000,
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "start": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      "take_lane": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "track": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "track",
      "start"
     ],
     "type": "object"
    },
    "Note": {
     "additionalProperties": false,
     "properties": {
      "duration": {
       "exclusiveMinimum": 0,
       "maximum": 16384,
       "type": "number"
      },
      "mute": {
       "default": false,
       "type": "boolean"
      },
      "pitch": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      },
      "probability": {
       "default": 1,
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "release_velocity": {
       "default": 64,
       "maximum": 127,
       "minimum": 0,
       "type": "number"
      },
      "start_time": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      "velocity": {
       "default": 100,
       "maximum": 127,
       "minimum": 1,
       "type": "number"
      },
      "velocity_deviation": {
       "default": 0,
       "maximum": 127,
       "minimum": -127,
       "type": "number"
      }
     },
     "required": [
      "pitch",
      "start_time",
      "duration"
     ],
     "type": "object"
    }
   },
   "properties": {
    "clips": {
     "items": {
      "$ref": "#/$defs/NewArrangementClip"
     },
     "type": "array"
    }
   },
   "required": [
    "clips"
   ],
   "type": "object"
  },
  "name": "live_create_arrangement_clips",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Create arrangement clips"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set arrangement clip fields (as live_set_clips). move_to, split_at and take-lane clips\nrefuse on Live 12.2; delete with live_delete.",
  "inputSchema": {
   "$defs": {
    "ArrangementClipAddr": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "type": "object"
    },
    "ArrangementEdit": {
     "additionalProperties": false,
     "properties": {
      "clip": {
       "$ref": "#/$defs/ArrangementClipAddr"
      },
      "color_index": {
       "anyOf": [
        {
         "maximum": 69,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "expect_name": {
       "anyOf": [
        {
         "maxLength": 256,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "gain": {
       "anyOf": [
        {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "launch_mode": {
       "anyOf": [
        {
         "enum": [
          "trigger",
          "gate",
          "toggle",
          "repeat"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "launch_quantization": {
       "anyOf": [
        {
         "enum": [
          "global",
          "none",
          "8 bars",
          "4 bars",
          "2 bars",
          "1 bar",
          "1/2",
          "1/2t",
          "1/4",
          "1/4t",
          "1/8",
          "1/8t",
          "1/16",
          "1/16t",
          "1/32"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "legato": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "loop": {
       "anyOf": [
        {
         "items": {
          "type": "number"
         },
         "maxItems": 2,
         "minItems": 2,
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "looping": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "markers": {
       "anyOf": [
        {
         "items": {
          "type": "number"
         },
         "maxItems": 2,
         "minItems": 2,
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "move_to": {
       "anyOf": [
        {
         "maximum": 16384,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "muted": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 256,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "pitch_coarse": {
       "anyOf": [
        {
         "maximum": 48,
         "minimum": -48,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "pitch_fine": {
       "anyOf": [
        {
         "maximum": 50,
         "minimum": -50,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "signature": {
       "anyOf": [
        {
         "items": {
          "type": "integer"
         },
         "maxItems": 2,
         "minItems": 2,
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "split_at": {
       "anyOf": [
        {
         "maximum": 16384,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "velocity_amount": {
       "anyOf": [
        {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "warp_mode": {
       "anyOf": [
        {
         "enum": [
          "beats",
          "tones",
          "texture",
          "re_pitch",
          "complex",
          "rex",
          "complex_pro"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "warping": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "clip"
     ],
     "type": "object"
    }
   },
   "properties": {
    "targets": {
     "items": {
      "$ref": "#/$defs/ArrangementEdit"
     },
     "type": "array"
    }
   },
   "required": [
    "targets"
   ],
   "type": "object"
  },
  "name": "live_edit_arrangement_clips",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Edit arrangement clips"
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Arrangement clips per track (index = order by start), take lanes, cue points (index =\norder by time), song length and loop. 256 clip rows max (truncated).",
  "inputSchema": {
   "properties": {
    "include": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "clips",
         "cues",
         "take_lanes"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "range": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "type": "string"
    },
    "tracks": {
     "anyOf": [
      {
       "items": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
          "type": "string"
         }
        ]
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "type": "object"
  },
  "name": "live_get_arrangement",
  "outputSchema": {
   "$defs": {
    "Arrangement": {
     "additionalProperties": true,
     "properties": {
      "cues": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "current_song_time": {
       "type": "number"
      },
      "loop": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "song_length": {
       "type": "number"
      },
      "tracks": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "truncated": {
       "type": "boolean"
      }
     },
     "required": [
      "song_length",
      "loop",
      "current_song_time"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/Arrangement"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Get arrangement"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Rename/jump/delete cues (index from live_get_arrangement) and add cues at exact times\n(transport stopped; an existing cue there is reused). Adds and deletes run as an operation:\npoll live_get_operation until ready.",
  "inputSchema": {
   "$defs": {
    "CueAdd": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "anyOf": [
        {
         "maxLength": 256,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "time": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "time"
     ],
     "type": "object"
    },
    "CueEdit": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "rename",
        "jump",
        "delete"
       ],
       "type": "string"
      },
      "cue": {
       "minimum": 0,
       "type": "integer"
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 256,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "cue",
      "action"
     ],
     "type": "object"
    }
   },
   "properties": {
    "add": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/CueAdd"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "cues": {
     "anyOf": [
      {
       "items": {
        "$ref": "#/$defs/CueEdit"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "type": "object"
  },
  "name": "live_set_cue_points",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Set cue points"
 }
]
