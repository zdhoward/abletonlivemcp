 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Arrangement clips per track (index = order by start), take lanes, cue points (index =\norder by time), song length and loop. 256 clip rows per reply. With `tracks`, a longer read\nis cut (truncated). Without, it reads the whole Set in pages: when a reply has `cursor`,\ncall again with it (same other arguments) to continue exactly there, even inside a track\n(that row says partial). A cursor is single use (10 min); one from a Set whose tracks\nchanged, or with other arguments, is refused. Group tracks: rows say group: true.",
  "inputSchema": {
   "properties": {
    "cursor": {
     "maxLength": 64,
     "type": "string"
    },
    "include": {
     "items": {
      "enum": [
       "clips",
       "cues",
       "take_lanes"
      ],
      "type": "string"
     },
     "type": "array"
    },
    "range": {
     "items": {
      "type": "number"
     },
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    },
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "type": "string"
    },
    "tracks": {
     "items": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
        "type": "string"
       }
      ]
     },
     "type": "array"
    }
   },
   "type": "object"
  },
  "name": "live_get_arrangement",
  "outputSchema": {
   "$defs": {
    "Arrangement": {
     "additionalProperties": true,
     "properties": {
      "cues": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "current_song_time": {
       "type": "number"
      },
      "cursor": {
       "type": "string"
      },
      "loop": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "song_length": {
       "type": "number"
      },
      "tracks": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "truncated": {
       "type": "boolean"
      }
     },
     "required": [
      "song_length",
      "loop",
      "current_song_time"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/Arrangement"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Get arrangement"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Rename/jump/delete cues (index from live_get_arrangement) and add cues at exact times\n(transport stopped; an existing cue there is reused). Deleting needs the local delete\npermission and your confirmation. Adds and deletes run as an operation: poll\nlive_get_operation until ready.",
  "inputSchema": {
   "$defs": {
    "CueAdd": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "maxLength": 256,
       "type": "string"
      },
      "time": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "time"
     ],
     "type": "object"
    },
    "CueEdit": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "rename",
        "jump",
        "delete"
       ],
       "type": "string"
      },
      "cue": {
       "minimum": 0,
       "type": "integer"
      },
      "name": {
       "maxLength": 256,
       "type": "string"
      }
     },
     "required": [
      "cue",
      "action"
     ],
     "type": "object"
    }
   },
   "properties": {
    "add": {
     "items": {
      "$ref": "#/$defs/CueAdd"
     },
     "type": "array"
    },
    "cues": {
     "items": {
      "$ref": "#/$defs/CueEdit"
     },
     "type": "array"
    }
   },
   "type": "object"
  },
  "name": "live_set_cue_points",
