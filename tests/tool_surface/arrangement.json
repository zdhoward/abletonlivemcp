[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "New arrangement clips at `start` beats: MIDI (length, notes) or audio (absolute file;\nplaced after the track's last clip), or from_session (scene index on the same track;\ncopies notes and Session automation to the timeline). Overlaps refuse. Copies are kept;\ndirect arrangement envelope reads are unavailable. replace=True deletes only clips wholly\ninside the destination span (needs the local delete permission and your confirmation).\nTake lanes refuse on 12.2.",
  "inputSchema": {
   "$defs": {
    "NewArrangementClip": {
     "additionalProperties": false,
     "properties": {
      "file": {
       "maxLength": 1024,
       "type": "string"
      },
      "kind": {
       "default": "midi",
       "enum": [
        "midi",
        "audio",
        "from_session"
       ],
       "type": "string"
      },
      "length": {
       "default": 4.0,
       "exclusiveMinimum": 0,
       "maximum": 1024,
       "type": "number"
      },
      "name": {
       "maxLength": 256,
       "type": "string"
      },
      "notes": {
       "items": {
        "$ref": "#/$defs/Note"
       },
       "maxItems": 400,
       "type": "array"
      },
      "replace": {
       "default": false,
       "type": "boolean"
      },
      "scene": {
       "minimum": 0,
       "type": "integer"
      },
      "start": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      "take_lane": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "track",
      "start"
     ],
     "type": "object"
    },
    "Note": {
     "additionalProperties": false,
     "properties": {
      "duration": {
       "exclusiveMinimum": 0,
       "maximum": 16384,
       "type": "number"
      },
      "mute": {
       "default": false,
       "type": "boolean"
      },
      "pitch": {
       "maximum": 127,
       "minimum": 0,
       "type": "integer"
      },
      "probability": {
       "default": 1,
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "release_velocity": {
       "default": 64,
       "maximum": 127,
       "minimum": 0,
       "type": "number"
      },
      "start_time": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      "velocity": {
       "default": 100,
       "maximum": 127,
       "minimum": 1,
       "type": "number"
      },
      "velocity_deviation": {
       "default": 0,
       "maximum": 127,
       "minimum": -127,
       "type": "number"
      }
     },
     "required": [
      "pitch",
      "start_time",
      "duration"
     ],
     "type": "object"
    }
   },
   "properties": {
    "clips": {
     "items": {
      "$ref": "#/$defs/NewArrangementClip"
     },
     "type": "array"
    }
   },
   "required": [
    "clips"
   ],
   "type": "object"
  },
  "name": "live_create_arrangement_clips",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "applied": {
     "items": {},
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "undo_steps": {
     "type": "integer"
    },
    "unverified": {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error",
    "applied"
   ],
   "type": "object"
  },
  "title": "Create arrangement clips"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set arrangement clip fields (as live_set_clips). move_to, split_at and take-lane clips\nrefuse on Live 12.2; delete with live_delete.",
  "inputSchema": {
   "$defs": {
    "ArrangementClipAddr": {
     "additionalProperties": false,
     "properties": {
      "arrangement": {
       "minimum": 0,
       "type": "integer"
      },
      "take_lane": {
       "minimum": 0,
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "type": "object"
    },
    "ArrangementEdit": {
     "additionalProperties": false,
     "properties": {
      "clip": {
       "$ref": "#/$defs/ArrangementClipAddr"
      },
      "color_index": {
       "maximum": 69,
       "minimum": 0,
       "type": "integer"
      },
      "expect_name": {
       "maxLength": 256,
       "type": "string"
      },
      "gain": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "launch_mode": {
       "enum": [
        "trigger",
        "gate",
        "toggle",
        "repeat"
       ],
       "type": "string"
      },
      "launch_quantization": {
       "enum": [
        "global",
        "none",
        "8 bars",
        "4 bars",
        "2 bars",
        "1 bar",
        "1/2",
        "1/2t",
        "1/4",
        "1/4t",
        "1/8",
        "1/8t",
        "1/16",
        "1/16t",
        "1/32"
       ],
       "type": "string"
      },
      "legato": {
       "type": "boolean"
      },
      "loop": {
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "looping": {
       "type": "boolean"
      },
      "markers": {
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "move_to": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      "muted": {
       "type": "boolean"
      },
      "name": {
       "maxLength": 256,
       "type": "string"
      },
      "pitch_coarse": {
       "maximum": 48,
       "minimum": -48,
       "type": "integer"
      },
      "pitch_fine": {
       "maximum": 50,
       "minimum": -50,
       "type": "number"
      },
      "signature": {
       "items": {
        "type": "integer"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "split_at": {
       "maximum": 16384,
       "minimum": 0,
       "type": "number"
      },
      "velocity_amount": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "warp_mode": {
       "enum": [
        "beats",
        "tones",
        "texture",
        "re_pitch",
        "complex",
        "rex",
        "complex_pro"
       ],
       "type": "string"
      },
      "warping": {
       "type": "boolean"
      }
     },
     "required": [
      "clip"
     ],
     "type": "object"
    }
   },
   "properties": {
    "targets": {
     "items": {
      "$ref": "#/$defs/ArrangementEdit"
     },
     "type": "array"
    }
   },
   "required": [
    "targets"
   ],
   "type": "object"
  },
  "name": "live_edit_arrangement_clips",
