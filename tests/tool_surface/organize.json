[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Your labels. `scope` set (Song, tracks, returns, from the open Set), global (plugins,\ndevices, samples, from the sidecar) or both; `kind` and `label` filter. Text is untrusted.",
  "inputSchema": {
   "properties": {
    "kind": {
     "anyOf": [
      {
       "enum": [
        "song",
        "track",
        "return_track",
        "plugin",
        "device",
        "sample"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "label": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "scope": {
     "default": "both",
     "enum": [
      "set",
      "global",
      "both"
     ],
     "type": "string"
    }
   },
   "type": "object"
  },
  "name": "live_get_labels",
  "outputSchema": {
   "$defs": {
    "Labels": {
     "additionalProperties": true,
     "properties": {
      "corrupt": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "scope": {
       "enum": [
        "set",
        "global",
        "both"
       ],
       "type": "string"
      },
      "set": {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
      },
      "unverified": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "scope"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "data": {
     "$ref": "#/$defs/Labels"
    },
    "provenance": {
     "const": "live_object_text_untrusted",
     "type": "string"
    }
   },
   "required": [
    "provenance",
    "data"
   ],
   "type": "object"
  },
  "title": "Get labels"
 },
 {
  "annotations": {
   "destructiveHint": true,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false
  },
  "description": "Set labels in one call. Items: `song` (no key), `track`/`return_track` (key = index,\noptional expect_name), `plugin`/`device`/`sample` (key = usage key). `mode` replace (empty\nlabels and no category clear it), add or remove. Set labels are written first, the sidecar\nlast; later failures return a receipt, with no rollback.",
  "inputSchema": {
   "$defs": {
    "LabelItem": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "anyOf": [
        {
         "maxLength": 40,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "expect_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Track kinds: refuse unless named exactly so"
      },
      "key": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Track/return index; usage key for plugin/device/sample; none for song"
      },
      "kind": {
       "enum": [
        "song",
        "track",
        "return_track",
        "plugin",
        "device",
        "sample"
       ],
       "type": "string"
      },
      "labels": {
       "items": {
        "maxLength": 40,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
       },
       "maxItems": 16,
       "type": "array"
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    }
   },
   "properties": {
    "items": {
     "items": {
      "$ref": "#/$defs/LabelItem"
     },
     "maxItems": 64,
     "minItems": 1,
     "type": "array"
    },
    "mode": {
     "default": "replace",
     "enum": [
      "replace",
      "add",
      "remove"
     ],
     "type": "string"
    }
   },
   "required": [
    "items"
   ],
   "type": "object"
  },
  "name": "live_set_labels",
  "outputSchema": {
   "$defs": {
    "ReceiptItem": {
     "additionalProperties": true,
     "properties": {
      "error": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "applied",
        "not_applied",
        "unknown",
        "not_attempted"
       ],
       "type": "string"
      },
      "result": {}
     },
     "required": [
      "index",
      "outcome"
     ],
     "type": "object"
    }
   },
   "additionalProperties": true,
   "properties": {
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "items": {
     "items": {
      "$ref": "#/$defs/ReceiptItem"
     },
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial"
     ],
     "type": "string"
    },
    "stopped_at": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "status",
    "items",
    "stopped_at",
    "error"
   ],
   "type": "object"
  },
  "title": "Set labels"
 }
]
