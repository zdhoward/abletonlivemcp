  "description": "One Session clip's envelope for a parameter: events and value_at_time samples (16\nevenly spaced, or sample_times beats). concise omits the event list.",
  "inputSchema": {
   "$defs": {
    "ArrangementClipAddr": {
     "additionalProperties": false,
     "description": "An arrangement clip: index into ``track.arrangement_clips`` sorted by start (optionally\nin take lane ``take_lane``).",
     "properties": {
      "arrangement": {
       "minimum": 0,
       "title": "Arrangement",
       "type": "integer"
      },
      "take_lane": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Take Lane"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ],
       "title": "Track"
      }
     },
     "required": [
      "track",
      "arrangement"
     ],
     "title": "ArrangementClipAddr",
     "type": "object"
    },
    "AutoParam": {
     "additionalProperties": false,
     "description": "A device parameter (``device`` path + ``parameter`` index) or a mixer control.",
     "properties": {
      "device": {
       "anyOf": [
        {
         "items": {
          "anyOf": [
           {
            "minimum": 0,
            "type": "integer"
           },
           {
            "pattern": "^pad:(0|[1-9]\\d?|1[01]\\d|12[0-7])$",
            "type": "string"
           }
          ]
         },
         "maxItems": 12,
         "minItems": 1,
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Device"
      },
      "mixer": {
       "anyOf": [
        {
         "enum": [
          "volume",
          "panning",
          "send",
          "track_activator",
          "crossfader"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Mixer"
      },
      "parameter": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Parameter"
      },
      "send": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Send"
      }
     },
     "title": "AutoParam",
     "type": "object"
    },
    "ClipAddr": {
     "additionalProperties": false,
     "description": "A Session clip slot.",
     "properties": {
      "scene": {
       "minimum": 0,
       "title": "Scene",
       "type": "integer"
      },
      "track": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "pattern": "^(return:(0|[1-9]\\d{0,2})|master)$",
         "type": "string"
        }
       ],
       "title": "Track"
      }
     },
     "required": [
      "track",
      "scene"
     ],
     "title": "ClipAddr",
     "type": "object"
    }
   },
   "properties": {
    "clip": {
     "anyOf": [
      {
       "$ref": "#/$defs/ClipAddr"
      },
      {
       "$ref": "#/$defs/ArrangementClipAddr"
      }
     ],
     "title": "Clip"
    },
    "parameter": {
     "$ref": "#/$defs/AutoParam"
    },
    "response_format": {
     "default": "concise",
     "enum": [
      "concise",
      "detailed"
     ],
     "title": "Response Format",
     "type": "string"
    },
    "sample_times": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Sample Times"
    }
   },
   "required": [
    "clip",
    "parameter"
   ],
   "title": "live_get_automationArguments",
   "type": "object"
  },
